# Copy as docker.env to customize the Docker container.
# .devops/compose.yaml reads this file via:
#   docker compose -f compose.yaml --env-file ../local/docker.env up
# Do not commit secrets.

# Name of the container (shown in `docker ps`).
CONTAINER_NAME=local-agent-ui

# Host port the UI is published on (http://127.0.0.1:8000 by default).
UI_PORT=8000

# Base image used to build the container.
BASE_IMAGE=python:3.12-slim

# LLM API (llama-server) the app talks to.
LLM_API_URL=http://host.docker.internal:8080/v1
