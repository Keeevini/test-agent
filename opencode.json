{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/model",
  "providers": {
    "llama-local": {
      "name": "llama.cpp (Local Server)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "general": {
          "modelID": "Qwen 27B",
          "capabilities": {
            "tools": true,
          },
          "limit": {
            "context": 65536,
            "output": 16384,
          },
        },
      },
    },
  },
}